{
  "_about": "Backline 'Soundcheck' colour tokens. Single source of truth: make_colorsets.py turns this into Assets.xcassets colour sets (any/dark plus high-contrast variants); contrast.py checks every pairing. Hex is sRGB. 'a' is opacity when a token is meant to be drawn translucent.",
  "modes": [
    "light",
    "dark"
  ],
  "tokens": {
    "canvas": {
      "light": "#F3EDE4",
      "dark": "#100E0C",
      "role": "screen background behind everything"
    },
    "surface": {
      "light": "#FFFCF7",
      "dark": "#1C1916",
      "role": "cards, stem rows, sheets"
    },
    "raised": {
      "light": "#EAE2D6",
      "dark": "#2A2521",
      "role": "secondary buttons, chips, steppers (fill)",
      "hc": {
        "light": "#E0D6C7",
        "dark": "#332D28"
      }
    },
    "sunken": {
      "light": "#E4DBCD",
      "dark": "#0A0908",
      "role": "the overview well, text fields"
    },
    "glassTint": {
      "light": "#F3EDE4",
      "dark": "#100E0C",
      "a": 0.55,
      "role": "tint under Liquid Glass / material chrome"
    },
    "hairline": {
      "light": "#1A1511",
      "dark": "#FFF4E6",
      "a": 0.1,
      "role": "decorative separators only (never the only boundary of a control)",
      "hc": {
        "light": "#1A1511",
        "dark": "#FFF4E6",
        "a": 0.24
      }
    },
    "stroke": {
      "light": "#8A7E73",
      "dark": "#7D7167",
      "role": "control boundaries that must be seen (3:1 against surface and canvas)",
      "hc": {
        "light": "#5F554C",
        "dark": "#B3A79B"
      }
    },
    "ink": {
      "light": "#1A1511",
      "dark": "#F7F1E8",
      "role": "primary text and icons"
    },
    "ink2": {
      "light": "#433A32",
      "dark": "#D8CEC2",
      "role": "secondary text",
      "hc": {
        "light": "#2C251F",
        "dark": "#EDE5DA"
      }
    },
    "ink3": {
      "light": "#6B6056",
      "dark": "#A99D91",
      "role": "tertiary text, captions, inactive icons (still 4.5:1)",
      "hc": {
        "light": "#433A32",
        "dark": "#D8CEC2"
      }
    },
    "accent": {
      "light": "#F2A12E",
      "dark": "#FFB23E",
      "role": "Tungsten: play button, primary buttons, playhead, selected state fill"
    },
    "accentEdge": {
      "light": "#9A5A00",
      "dark": "#FFB23E",
      "role": "1 pt edge on accent fills (light mode needs it to reach 3:1 on paper)",
      "hc": {
        "light": "#7A4500",
        "dark": "#FFD08A"
      }
    },
    "onAccent": {
      "light": "#1B1206",
      "dark": "#1B1206",
      "role": "text and glyphs on accent fills"
    },
    "accentText": {
      "light": "#8F5200",
      "dark": "#FFC46B",
      "role": "accent used as text or a thin glyph (links, selected labels)",
      "hc": {
        "light": "#7A4500",
        "dark": "#FFD08A"
      }
    },
    "accentSoft": {
      "light": "#F2A12E",
      "dark": "#FFB23E",
      "a": 0.18,
      "role": "selected chip fill behind accentText"
    },
    "live": {
      "light": "#B42C23",
      "dark": "#FF6A5C",
      "role": "record, destructive, errors"
    },
    "ok": {
      "light": "#17703C",
      "dark": "#5BD68E",
      "role": "done, success"
    },
    "caution": {
      "light": "#7A5900",
      "dark": "#FFD75E",
      "role": "warnings (always with an icon)"
    },
    "switchOff": {
      "light": "#8F8377",
      "dark": "#6E645B",
      "role": "off track of the part switch (3:1 against surface)",
      "hc": {
        "light": "#6B6056",
        "dark": "#8F8377"
      }
    },
    "knob": {
      "light": "#FFFFFF",
      "dark": "#F7F1E8",
      "role": "switch knob, slider thumb"
    },
    "waveIdle": {
      "light": "#857A6E",
      "dark": "#6D655D",
      "role": "overview bars not yet played (3:1 against sunken)",
      "hc": {
        "light": "#6B6056",
        "dark": "#8F8377"
      }
    },
    "wavePlayed": {
      "light": "#1A1511",
      "dark": "#F2EBE1",
      "role": "overview bars already played (ink: lit by the beam)"
    },
    "waveLit": {
      "light": "#5E3F12",
      "dark": "#E8C48A",
      "role": "unplayed bars inside the loop: the loop lights them up"
    },
    "waveOff": {
      "light": "#A79B8F",
      "dark": "#5B534C",
      "role": "bars of a part that is off (meant to look dark; state is also in text)",
      "hc": {
        "light": "#8A7E73",
        "dark": "#776D64"
      }
    },
    "playhead": {
      "light": "#9A5A00",
      "dark": "#FFB23E",
      "role": "the playhead beam (Tungsten, glow in dark mode)"
    },
    "loopFill": {
      "light": "#F2A12E",
      "dark": "#FFB23E",
      "a": 0.24,
      "role": "the lit loop region in the overview"
    },
    "loopEdge": {
      "light": "#1A1511",
      "dark": "#F7F1E8",
      "role": "loop edge lines and their spike-tape tabs"
    },
    "scrim": {
      "light": "#100E0C",
      "dark": "#000000",
      "a": 0.55,
      "role": "over photos so text on them stays readable"
    },
    "pressed": {
      "light": "#DDD3C5",
      "dark": "#36302A",
      "role": "pressed state of raised controls"
    },
    "accentPressed": {
      "light": "#DB8E1C",
      "dark": "#F09F28",
      "role": "pressed state of accent fills"
    },
    "tapeFill": {
      "light": "#E9DCBF",
      "dark": "#2E2925",
      "role": "console tape (section labels, part chips): masking tape on paper, gaffer tape on stage"
    },
    "tapeInk": {
      "light": "#1A1511",
      "dark": "#F7F1E8",
      "role": "marker ink on tapeFill"
    },
    "onPhoto": {
      "light": "#F7F1E8",
      "dark": "#F7F1E8",
      "role": "text on photographs (always over scrim), both modes"
    }
  },
  "stems": {
    "_about": "Part colours (coloured tape on a desk). Hex per mode, contrast-checked against surface. Dark L=0.76, light L=0.50 in OKLCH, chroma 0.14; 'other' moved from hue 90 to 118 so it never reads as the Tungsten accent.",
    "vocals": {
      "hue": 20
    },
    "leadGuitar": {
      "hue": 345
    },
    "rhythmGuitar": {
      "hue": 300
    },
    "guitar": {
      "hue": 345
    },
    "bass": {
      "hue": 262
    },
    "drums": {
      "hue": 205
    },
    "keys": {
      "hue": 152
    },
    "other": {
      "hue": 118
    },
    "kick": {
      "hue": 222
    },
    "snare": {
      "hue": 190
    },
    "hats": {
      "hue": 172
    },
    "toms": {
      "hue": 240
    }
  },
  "stemLightness": {
    "light": 0.5,
    "dark": 0.76,
    "chroma": 0.14
  },
  "_hc": "\"hc\" holds the Increase Contrast variant (asset catalog contrast=high). Tokens without it reuse the normal value."
}
